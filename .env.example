# Database (SQLite for local dev; use PostgreSQL in production)
DATABASE_URL=sqlite:///./freelanceshield.db
# DATABASE_URL=postgresql://freelanceshield:freelanceshield@localhost:5432/freelanceshield

# Redis (optional — for future rate limiting)
REDIS_URL=redis://localhost:6379/0

# Auth — generate unique 64-char hex strings for production
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PORTAL_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@freelanceshield.com
EMAIL_FROM_NAME=FreelanceShield
RESEND_API_KEY=
SENDGRID_API_KEY=

# Storage (local for dev; set S3_* for production)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET=freelanceshield-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# OAuth integrations
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=

# Scheduler
ENABLE_SCHEDULER=true
JOB_POLL_INTERVAL_SECONDS=60

# App
APP_URL=http://localhost:8000
PORTAL_URL=http://localhost:8000/portal
NODE_ENV=development
